      "type": "object"
    },
    "SearchTrace": {
      "additionalProperties": true,
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage"
      ],
      "title": "SearchTrace",
      "type": "object"
    },
    "TimeWindow": {
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "TimelineEntry": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": [
            "travel",
            "activity"
          ],
          "title": "Type",
          "type": "string"
        },
        "minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minutes"
        }
      },
      "required": [
        "type"
      ],
      "title": "TimelineEntry",
      "type": "object"
    }
  },
  "description": "Used only to generate a single schema containing all browser request/response types.",
  "properties": {
    "search": {
      "$ref": "#/$defs/DateSearch"
    },
    "response": {
      "$ref": "#/$defs/DateSearchResponse"
    },
    "replace": {
      "$ref": "#/$defs/ActivityReplacement"
    },
    "compose": {
      "$ref": "#/$defs/DateComposition"
    }
  },
  "required": [
    "search",
    "response",
    "replace",
    "compose"
  ],
  "title": "DeckContract",
  "type": "object"
}
