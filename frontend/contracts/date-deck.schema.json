        "max_total_duration_minutes": {
          "default": 360,
          "maximum": 1440,
          "minimum": 15,
          "title": "Max Total Duration Minutes",
          "type": "integer"
        },
        "max_travel_time_minutes": {
          "default": 30,
          "maximum": 180,
          "minimum": 0,
          "title": "Max Travel Time Minutes",
          "type": "integer"
        }
