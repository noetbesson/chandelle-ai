            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget"
        },
        "categories": {
          "items": {
            "enum": [
              "food",
              "culture",
              "concerts",
              "cinema",
              "outdoors",
              "sport",
              "workshops",
              "nightlife",
              "home",
              "travel"
