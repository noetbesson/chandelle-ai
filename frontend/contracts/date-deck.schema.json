        "radius_km": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius Km"
        },
        "activity_count": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "title": "Activity Count",
          "type": "integer"
        },
        "max_plans": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Plans",
          "type": "integer"
        },
        "mode": {
          "default": "auto",
          "enum": [
            "offline",
            "openai",
            "auto"
