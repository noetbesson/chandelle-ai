# Local mode: no external AI call. Environment variables are read by the server only.
REELS_NORMALIZATION_BACKEND=local
REELS_LIVE_ENABLED=0
GRADIUM_API_KEY=
OPENAI_API_KEY=
PIPELEX_API_KEY=
REELS_OPENAI_MODEL=gpt-4o
# Absolute paths if tools are not in .runtime/tools (ffmpeg.exe / ffprobe.exe on Windows).
REELS_FFMPEG_PATH=
REELS_FFPROBE_PATH=
