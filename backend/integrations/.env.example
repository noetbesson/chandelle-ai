# Copy to the repository root as .env (ignored by Git). Never put keys in chat.
OPENAI_API_KEY=
OPENAI_ENABLED=0
OPENAI_WEB_ENABLED=0
# Bounded depth: 1..4 tool calls, 1..16 returned facts. No 100-call loop.
OPENAI_WEB_MAX_TOOL_CALLS=4
OPENAI_WEB_RESULT_LIMIT=16
OPENAI_MODEL=gpt-4.1-mini
OPENAI_WEB_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# USD conservative reservations, not the balance/invoice of your provider account.
OPENAI_DAILY_RESERVE_USD=1
OPENAI_TOTAL_RESERVE_USD=10
# Keep explanations local to avoid extra calls per generated plan.
OPENAI_PLAN_EXPLANATIONS=0
# local works without dependencies or credits; pipelex requires the optional local runtime.
DATE_SCORING_BACKEND=local
# Independent video providers are not included in the quota above. Keep disabled.
REELS_LIVE_ENABLED=0
REELS_NORMALIZATION_BACKEND=local

# Spoken discovery. Secrets stay on the server; these calls have a separate quota.
GRADIUM_ENABLED=0
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=
GRADIUM_STT_MODEL=default
GRADIUM_TTS_MODEL=default

# Calendar OAuth. Register the exact callbacks below with each provider.
CALENDAR_REDIRECT_BASE=http://localhost:8000
# Fernet key, generated once and kept only in the ignored root .env.
CALENDAR_TOKEN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Scheduler only runs while this one-worker server is running. Both people opt in.
PROACTIVE_SCHEDULER_ENABLED=0
PROACTIVE_DEMO_MODE=0
# Optional consented mood analysis, covered by the existing OpenAI budget.
PROACTIVE_MOOD_OPENAI=0
# For a dedicated test calendar only, also requires CHANDELLE_DEV=1.
CALENDAR_ALLOW_DEMO_EVENTS=0
CHANDELLE_DEV=0
